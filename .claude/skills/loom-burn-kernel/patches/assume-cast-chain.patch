diff --git a/loom/src/loom/transforms/scalar/combine_patterns.c b/loom/src/loom/transforms/scalar/combine_patterns.c
index 889a587..4303de6 100644
--- a/loom/src/loom/transforms/scalar/combine_patterns.c
+++ b/loom/src/loom/transforms/scalar/combine_patterns.c
@@ -12,6 +12,24 @@
 #include "loom/transforms/conversion/chain.h"
 #include "loom/transforms/scalar/narrowing.h"
 
+// Local patch (loom-burn-kernel skill): compose a conversion chain only with
+// the conversion that directly defines the outer input. Looking through value
+// identities (loom_rewriter_value_defining_op) skips a scalar.assume between
+// the two casts, so extsi(assume(extsi i16 -> i32)) -> i64 became one
+// extsi i16 -> i64 and the assumed range was lost (SUBRANGE/026 on indices
+// loaded from short fields; regression from hrx-system #2074).
+static loom_op_t* loom_scalar_combine_direct_defining_op(
+    const loom_rewriter_t* rewriter, loom_value_id_t value_id) {
+  loom_value_t* value = loom_module_value(rewriter->module, value_id);
+  if (loom_value_is_block_arg(value)) {
+    return NULL;
+  }
+  loom_op_t* definition = loom_value_def_op(value);
+  return definition && !iree_any_bit_set(definition->flags, LOOM_OP_FLAG_DEAD)
+             ? definition
+             : NULL;
+}
+
 static loom_conversion_kind_t loom_scalar_combine_conversion_kind(
     const loom_op_t* op) {
   switch (op->kind) {
@@ -127,7 +145,7 @@ iree_status_t loom_scalar_combine_conversion(loom_op_t* op,
   // Callers supply a verified unary width conversion.
   const loom_value_id_t outer_input = loom_op_const_operands(op)[0];
   loom_op_t* defining_op =
-      loom_rewriter_value_defining_op(rewriter, outer_input);
+      loom_scalar_combine_direct_defining_op(rewriter, outer_input);
   if (defining_op == NULL) {
     return iree_ok_status();
   }
