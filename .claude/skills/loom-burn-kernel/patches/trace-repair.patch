+// LOOM_TRACE_REPAIR=1 prints one line per spill-free repair round to stderr
+// (round, budget, function size, outcome, cumulative repair counters, round
+// time). Off by default; output and results are unchanged without it.
+static bool loom_low_emission_frame_trace_repair_enabled(void) {
+  static int enabled = -1;
+  if (enabled < 0) {
+    const char* value = getenv("LOOM_TRACE_REPAIR");
+    enabled = (value != NULL && value[0] != 0 && value[0] != '0') ? 1 : 0;
+  }
+  return enabled == 1;
+}
